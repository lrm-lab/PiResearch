# Copy to .env. In production these come from the PiResearch server's .env (managed outside the repo)
# and compose passes them to the coforge-app service.

# Leave COFORGE_ISSUER unset to switch the CoForge App off: the service then answers 404 everywhere.
# The CoForge issuer: <your CoForge origin>/oidc, no trailing slash.
COFORGE_ISSUER=https://coforge.example.com/oidc
# The app's client ID; Agent access tokens carry it as their audience.
COFORGE_CLIENT_ID=piresearch
# The public https origin PiResearch is served at (the manifest's base_url is APP_ORIGIN + /api/coforge).
APP_ORIGIN=https://82.157.184.89
# PiResearch's own HTTP API on the compose network (compose sets this; it is the galaxy proxy port).
PIRESEARCH_INTERNAL_URL=http://piresearch:8766
# Optional. Runs one Workspace may have in progress at once (default 2).
# COFORGE_MAX_CONCURRENT_RUNS=2
# Optional. Where the Workspace-to-run store lives (default ./data; the image uses the /data volume).
# COFORGE_APP_DATA_DIR=./data
# Optional. The manifest's docs_url.
# COFORGE_DOCS_URL=
PORT=3000
