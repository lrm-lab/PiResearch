{
	# HTTPS clients hitting the bare IP send no SNI, so the certificate for the
	# IP has to be selected explicitly. Without this the TLS handshake has
	# nothing to match against.
	default_sni 82.157.184.89
}

# Let's Encrypt IP certificates use the short-lived profile and renew on their
# own. HTTP-01 is chosen explicitly: it is the challenge type supported for a
# bare public IPv4 address, and it does not contend with the HTTPS listener.
82.157.184.89 {
	tls {
		issuer acme {
			profile shortlived
			disable_tlsalpn_challenge
		}
	}

	encode gzip

	# The 3D galaxy is the front door. The 2D homepage still exists upstream
	# (the app keeps it for deep links and the no-WebGL fallback).
	@root path /
	redir @root /galaxy/ 302

	reverse_proxy piresearch:8766
}
